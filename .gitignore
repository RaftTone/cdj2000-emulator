# Nothing derived from firmware belongs in this repository.  See FIRMWARE.md:
# you supply your own update file and everything below is built from it.
/firmware/
/packets/
/runs/
/bin/
/build/

# Claude Code creates agent worktrees here; they are checkouts of this repo and
# must never be committed into it.
/.claude/worktrees/

# Belt and braces: the same files by name, wherever they land.
*.UPD
*.upd
*.LDR
*.ldr
*.bin
*.elf
*.dis
*.ppm
*.img
*.pdb

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local MAIN stderr capture
/vm-main-stderr.log
# boot_vm's per-port logs when TEMP is the checkout: MAIN's and the GUI's own
# console text, so firmware-derived like everything under /runs/
/vm-main*.log
/vm-gui*.log
/vm-console*.txt

# Local build logs
/build-*.log
