+/* The co-simulation with the MAIN board: one guest time for both.
+
+   BFIN_COSIM=host:port connects to the MAIN machine's co-simulation port
+   (emulator/qemu/cdj2000_cosim.c, which has the whole story and the wire
+   format) and implies BFIN_TIME_BASE=virtual.  The link to MAIN then goes
+   over that one connection: MAIN's records arrive stamped with MAIN's guest
+   time and are handed to the SPORT model -- the same split into slots as
+   records off the old record socket -- at that time plus the link latency;
+   the GUI's requests leave stamped with this board's guest time.  The run
+   loop never goes further than MAIN's reported time plus the latency, and
+   reports its own time every half latency and whenever it waits, so neither
+   board ever sees the other in its future or its past.  */
+
+#define BFIN_COSIM_TIME 1
+#define BFIN_COSIM_RECORD 2
+#define BFIN_COSIM_REQUEST 3
+#define BFIN_COSIM_HELLO 4
+#define BFIN_COSIM_HEADER 20
+#define BFIN_COSIM_PAYLOAD_MAX 8192
+
+struct bfin_cosim_due
+{
+  struct bfin_cosim_due *next;
+  int64_t due;			/* guest ns it reaches this board */
+  unsigned len;
+  unsigned char data[];
+};
+
+static struct
+{
+  int enabled;			/* -1 until the environment is read */
+  int active;
+  int fd;
+  int64_t epoch;		/* the tick that is guest time 0 */
+  int64_t quantum;		/* ns: the latency and the lookahead */
+  int64_t peer;			/* MAIN's time, as far as it has told us */
+  int64_t peer_promise;		/* MAIN sends nothing before this */
+  int64_t reported;		/* ours, as far as MAIN knows */
+  int64_t promised;		/* the promise we last sent */
+  int64_t next_ticks;		/* when the run loop has to step */
+  struct bfin_cosim_due *head, *tail;
+  void (*inject) (void *, const unsigned char *, unsigned);
+  void *inject_ctx;
+  SIM_DESC sd;
+  unsigned char in[BFIN_COSIM_HEADER + BFIN_COSIM_PAYLOAD_MAX + 65536];
+  size_t in_len;
+  unsigned long steps, waits, records, requests, early, late;
+  double wait_s;
+} bfin_cosim = { .enabled = -1, .fd = -1 };
+
+int
+bfin_cosim_enabled (void)
+{
+  if (bfin_cosim.enabled < 0)
+    {
+      const char *spec = getenv ("BFIN_COSIM");
+
+      bfin_cosim.enabled = spec != NULL && *spec != '\0';
+    }
+  return bfin_cosim.enabled;
 }
 
+static int64_t
+bfin_cosim_ns (int64_t ticks)
+{
+  return (int64_t) ((double) (ticks - bfin_cosim.epoch) * 1e9
+		    / bfin_wall.cclk_hz);
+}
+
+/* The first tick at or after guest time NS.  */
+static int64_t
+bfin_cosim_ticks (int64_t ns)
+{
+  double ticks = (double) ns * bfin_wall.cclk_hz / 1e9;
+  int64_t whole = (int64_t) ticks;
+
+  return bfin_cosim.epoch + whole + ((double) whole < ticks);
+}
+
+/* MAIN is gone -- the link closed, was reset or failed.  In one guest time
+   there is nothing left to run against, so exit normally: the atexit work
+   happens, the flash dump (BFIN_CFI_DUMP) of an update run in particular.
+   Only a malformed message keeps the GUI running, alone, for a post-mortem. */
+static void bfin_cosim_stats (void);
+
+static void
+bfin_cosim_lost (const char *why)
+{
+  if (!bfin_cosim.active)
+    return;
+  bfin_cosim.active = 0;
+  bfin_cosim.next_ticks = INT64_MAX;
+  if (strstr (why, "malformed") == NULL)
+    {
+      fprintf (stderr, "bfin-cosim: %s at guest t=%.6f; exiting\n", why,
+	       bfin_cosim_ns (sim_events_time (bfin_cosim.sd)) / 1e9);
+      bfin_cosim.active = 1;
+      bfin_cosim_stats ();
+      fflush (stderr);
+      exit (0);
+    }
+  fprintf (stderr, "bfin-cosim: %s at guest t=%.6f; the GUI runs on alone\n",
+	   why, bfin_cosim_ns (sim_events_time (bfin_cosim.sd)) / 1e9);
+  fflush (stderr);
+}
+
+#ifdef _WIN32
+static void
+bfin_cosim_write (const unsigned char *data, size_t len)
+{
+  (void) data;
+  (void) len;
+}
+
+static void
+bfin_cosim_connect (SIM_DESC sd)
+{
+  (void) sd;
+  fprintf (stderr, "bfin-cosim: BFIN_COSIM is not supported on Windows yet\n");
+  exit (2);
+}
+#else
+static void
+bfin_cosim_write (const unsigned char *data, size_t len)
+{
+  while (len && bfin_cosim.active)
+    {
+      ssize_t put = send (bfin_cosim.fd, data, len, 0);
+
+      if (put > 0)
+	{
+	  data += put;
+	  len -= (size_t) put;
+	}
+      else if (put < 0 && errno == EINTR)
+	continue;
+      else
+	bfin_cosim_lost (put < 0 ? strerror (errno) : "the link closed");
+    }
+}
+#endif
+
+static void
+bfin_cosim_send (unsigned type, int64_t t, const unsigned char *payload,
+		 unsigned len)
+{
+  unsigned char header[BFIN_COSIM_HEADER] = { 'C', 'D', 'J', 'C' };
+  int i;
+
+  if (!bfin_cosim.active)
+    return;
+  header[4] = (unsigned char) type;
+  for (i = 0; i < 8; i++)
+    header[8 + i] = (unsigned char) ((uint64_t) t >> (8 * i));
+  for (i = 0; i < 4; i++)
+    header[16 + i] = (unsigned char) (len >> (8 * i));
+  bfin_cosim_write (header, sizeof (header));
+  if (len)
+    bfin_cosim_write (payload, len);
+  if (t > bfin_cosim.reported)
+    bfin_cosim.reported = t;
+}
+
+#ifndef _WIN32
+static void
+bfin_cosim_connect (SIM_DESC sd)
+{
+  const char *spec = getenv ("BFIN_COSIM");
+  const char *quantum = getenv ("BFIN_COSIM_QUANTUM_US");
+  const char *colon = strrchr (spec, ':');
+  struct sockaddr_in address;
+  char host[64] = "127.0.0.1";
+  unsigned port;
+  int tries, one = 1;
+
+  if (colon)
+    {
+      size_t n = (size_t) (colon - spec);
+
+      if (n && n < sizeof (host))
+	{
+	  memcpy (host, spec, n);
+	  host[n] = '\0';
+	}
+      port = (unsigned) strtoul (colon + 1, NULL, 0);
+    }
+  else
+    port = (unsigned) strtoul (spec, NULL, 0);
+  memset (&address, 0, sizeof (address));
+  address.sin_family = AF_INET;
+  address.sin_port = htons (port);
+  inet_pton (AF_INET, host, &address.sin_addr);
+
+  /* MAIN listens from the moment its machine is built; give it a minute.  */
+  for (tries = 0; tries < 600; tries++)
+    {
+      bfin_cosim.fd = (int) socket (AF_INET, SOCK_STREAM, 0);
+      if (bfin_cosim.fd >= 0
+	  && connect (bfin_cosim.fd, (struct sockaddr *) &address,
+		      sizeof (address)) == 0)
+	break;
+      if (bfin_cosim.fd >= 0)
+	close (bfin_cosim.fd);
+      bfin_cosim.fd = -1;
+      usleep (100000);
+    }
+  if (bfin_cosim.fd < 0)
+    {
+      fprintf (stderr, "bfin-cosim: nothing listens on %s:%u\n", host, port);
+      exit (2);
+    }
+  setsockopt (bfin_cosim.fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof (one));
+  bfin_cosim.sd = sd;
+  bfin_cosim.active = 1;
+  bfin_cosim.quantum = (int64_t) (quantum && *quantum
+				  ? strtoll (quantum, NULL, 0) : 100) * 1000;
+  bfin_cosim.epoch = sim_events_time (sd);
+  bfin_cosim.peer = bfin_cosim.reported = 0;
+  bfin_cosim.peer_promise = bfin_cosim.promised = 0;
+  bfin_cosim_send (BFIN_COSIM_HELLO, 0, NULL, 0);
+  bfin_cosim.next_ticks = bfin_cosim_ticks (bfin_cosim.quantum / 2);
+  fprintf (stderr, "bfin-cosim: on with MAIN at %s:%u, link latency %"
+	   PRId64 " us, guest time 0 = tick %" PRId64 "\n", host, port,
+	   bfin_cosim.quantum / 1000, bfin_cosim.epoch);
+  fflush (stderr);
+}
+#endif
+
+static void
+bfin_cosim_parse (void)
+{
+  size_t at = 0;
+
+  while (bfin_cosim.active && bfin_cosim.in_len - at >= BFIN_COSIM_HEADER)
+    {
+      const unsigned char *head = bfin_cosim.in + at;
+      unsigned type = head[4];
+      unsigned len = head[16] | (head[17] << 8) | (head[18] << 16)
+		     | ((unsigned) head[19] << 24);
+      uint64_t t = 0;
+      int i;
+
+      for (i = 7; i >= 0; i--)
+	t = (t << 8) | head[8 + i];
+      if (memcmp (head, "CDJC", 4) != 0 || len > BFIN_COSIM_PAYLOAD_MAX)
+	{
+	  bfin_cosim_lost ("a malformed message from MAIN");
+	  return;
+	}
+      if (bfin_cosim.in_len - at < BFIN_COSIM_HEADER + len)
+	break;
+      if (type == BFIN_COSIM_RECORD && len)
+	{
+	  struct bfin_cosim_due *due = xmalloc (sizeof (*due) + len);
+
+	  due->next = NULL;
+	  due->due = (int64_t) t + bfin_cosim.quantum;
+	  /* A record due before this board's time broke a promise.  Counted,
+	     and handed over at once.  */
+	  if (due->due < bfin_cosim_ns (sim_events_time (bfin_cosim.sd)))
+	    bfin_cosim.late++;
+	  due->len = len;
+	  memcpy (due->data, head + BFIN_COSIM_HEADER, len);
+	  if (bfin_cosim.tail)
+	    bfin_cosim.tail->next = due;
+	  else
+	    bfin_cosim.head = due;
+	  bfin_cosim.tail = due;
+	  bfin_cosim.records++;
+	}
+      /* Every message says how far MAIN has got; a TIME with a payload also
+	 says MAIN sends nothing before that time.  */
+      if ((int64_t) t > bfin_cosim.peer)
+	bfin_cosim.peer = (int64_t) t;
+      {
+	int64_t promise = (int64_t) t;
+
+	if (type == BFIN_COSIM_TIME && len == 8)
+	  {
+	    uint64_t v = 0;
+
+	    for (i = 7; i >= 0; i--)
+	      v = (v << 8) | head[BFIN_COSIM_HEADER + i];
+	    promise = (int64_t) v;
+	  }
+	if (promise > bfin_cosim.peer_promise)
+	  bfin_cosim.peer_promise = promise;
+      }
+      at += BFIN_COSIM_HEADER + len;
+    }
+  memmove (bfin_cosim.in, bfin_cosim.in + at, bfin_cosim.in_len - at);
+  bfin_cosim.in_len -= at;
+}
+
+static void
+bfin_cosim_drain (void)
+{
+#ifndef _WIN32
+  while (bfin_cosim.active)
+    {
+      ssize_t got;
+
+      if (bfin_cosim.in_len == sizeof (bfin_cosim.in))
+	{
+	  bfin_cosim_parse ();
+	  if (bfin_cosim.in_len == sizeof (bfin_cosim.in))
+	    {
+	      bfin_cosim_lost ("a message larger than the input buffer");
+	      break;
+	    }
+	}
+      got = recv (bfin_cosim.fd, bfin_cosim.in + bfin_cosim.in_len,
+		  sizeof (bfin_cosim.in) - bfin_cosim.in_len, MSG_DONTWAIT);
+      if (got > 0)
+	bfin_cosim.in_len += (size_t) got;
+      else if (got == 0)
+	bfin_cosim_lost ("MAIN closed the link");
+      else if (errno == EINTR)
+	continue;
+      else if (errno == EAGAIN || errno == EWOULDBLOCK)
+	break;
+      else
+	bfin_cosim_lost (strerror (errno));
+    }
+#endif
+  bfin_cosim_parse ();
+}
+
+/* MAIN's records whose time has come, to the SPORT model.  Records that come
+   before the firmware has touched the link wait for it -- the old record
+   socket kept them the same way, in its buffer.  */
+static void
+bfin_cosim_deliver (int64_t now)
+{
+  while (bfin_cosim.head && bfin_cosim.head->due <= now)
+    {
+      struct bfin_cosim_due *due = bfin_cosim.head;
+
+      if (!bfin_cosim.inject)
+	{
+	  bfin_cosim.early++;
+	  break;
+	}
+      bfin_cosim.head = due->next;
+      if (!bfin_cosim.head)
+	bfin_cosim.tail = NULL;
+      bfin_cosim.inject (bfin_cosim.inject_ctx, due->data, due->len);
+      free (due);
+    }
+}
+
+void
+bfin_cosim_attach_link (void (*inject) (void *, const unsigned char *,
+					unsigned),
+			void *ctx)
+{
+  bfin_cosim.inject = inject;
+  bfin_cosim.inject_ctx = ctx;
+  if (bfin_cosim.active)
+    bfin_cosim_deliver (bfin_cosim_ns (sim_events_time (bfin_cosim.sd)));
+}
+
+void
+bfin_cosim_send_request (const unsigned char *data, unsigned len)
+{
+  if (!bfin_cosim.active)
+    return;
+  bfin_cosim.requests++;
+  bfin_cosim_send (BFIN_COSIM_REQUEST,
+		   bfin_cosim_ns (sim_events_time (bfin_cosim.sd)), data, len);
+}
+
+static void
+bfin_cosim_stats (void)
+{
+  if (bfin_cosim.active)
+    fprintf (stderr, "STATS cosim steps=%lu waits=%lu wait_s=%.2f"
+	     " records=%lu requests=%lu early=%lu late=%lu main_t=%.6f"
+	     " main_promise=%.6f\n",
+	     bfin_cosim.steps, bfin_cosim.waits, bfin_cosim.wait_s,
+	     bfin_cosim.records, bfin_cosim.requests, bfin_cosim.early,
+	     bfin_cosim.late, bfin_cosim.peer / 1e9,
+	     bfin_cosim.peer_promise / 1e9);
+}
+
+/* The earliest guest time this board could send anything.  While the core
+   runs, now.  While it is parked, not before its next event, a record due
+   from MAIN, or the earliest a message from MAIN could arrive -- the
+   lookahead that lets MAIN run on to it (cdj2000_cosim.c has the story).  */
+static int64_t
+bfin_cosim_promise (SIM_DESC sd, int64_t now, int parked)
+{
+  int64_t promise, next_event;
+
+  if (!parked)
+    return now;
+  next_event = STATE_EVENTS (sd)->time_from_event;
+  promise = next_event > 0
+    ? bfin_cosim_ns (sim_events_time (sd) + next_event) : now;
+  if (bfin_cosim.head && bfin_cosim.inject && bfin_cosim.head->due < promise)
+    promise = bfin_cosim.head->due;
+  if (bfin_cosim.peer_promise + bfin_cosim.quantum < promise)
+    promise = bfin_cosim.peer_promise + bfin_cosim.quantum;
+  return promise > now ? promise : now;
+}
+
+static void
+bfin_cosim_report (int64_t now, int64_t promise)
+{
+  unsigned char payload[8];
+  int i;
+
+  for (i = 0; i < 8; i++)
+    payload[i] = (unsigned char) ((uint64_t) promise >> (8 * i));
+  bfin_cosim_send (BFIN_COSIM_TIME, now, payload, sizeof (payload));
+  bfin_cosim.promised = promise;
+}
+
+/* Take what MAIN sent, hand over the records that are due, tell MAIN where
+   this board is and what it promises, and wait while it is a whole latency
+   ahead of what MAIN has promised.  */
+static void
+bfin_cosim_step (SIM_DESC sd, int parked)
+{
+  int64_t now = bfin_cosim_ns (sim_events_time (sd));
+  int64_t next, promise;
+  double wall = 0;
+
+  bfin_cosim.steps++;
+  bfin_cosim_drain ();
+  bfin_cosim_deliver (now);
+  if (bfin_cosim.head && bfin_cosim.head->due <= now)
+    parked = 0;			/* a record is being handed over: awake */
+  promise = bfin_cosim_promise (sd, now, parked);
+  if (now - bfin_cosim.reported >= bfin_cosim.quantum / 2
+      || promise > bfin_cosim.promised)
+    bfin_cosim_report (now, promise);
+  while (bfin_cosim.active
+	 && now >= bfin_cosim.peer_promise + bfin_cosim.quantum)
+    {
+#ifndef _WIN32
+      struct pollfd wait = { .fd = bfin_cosim.fd, .events = POLLIN };
+
+      promise = bfin_cosim_promise (sd, now, parked);
+      if (bfin_cosim.reported != now || promise != bfin_cosim.promised)
+	bfin_cosim_report (now, promise);
+      if (wall == 0)
+	{
+	  wall = bfin_wall_seconds ();
+	  bfin_cosim.waits++;
+	}
+      if (poll (&wait, 1, 1000) == 0)
+	continue;
+#endif
+      bfin_cosim_drain ();
+      bfin_cosim_deliver (now);
+    }
+  if (wall != 0)
+    bfin_cosim.wait_s += bfin_wall_seconds () - wall;
+  if (!bfin_cosim.active)
+    return;
+  next = bfin_cosim.peer_promise + bfin_cosim.quantum;
+  promise = bfin_cosim_promise (sd, now, parked);
+  if (promise > bfin_cosim.promised)
+    bfin_cosim_report (now, promise);
+  /* running: report every half latency; parked: at the promise */
+  if (promise == now)
+    {
+      if (bfin_cosim.reported + bfin_cosim.quantum / 2 < next)
+	next = bfin_cosim.reported + bfin_cosim.quantum / 2;
+    }
+  else if (promise < next)
+    next = promise;
+  if (bfin_cosim.head && bfin_cosim.inject && bfin_cosim.head->due < next)
+    next = bfin_cosim.head->due;
+  bfin_cosim.next_ticks = bfin_cosim_ticks (next);
+  if (bfin_cosim.next_ticks <= sim_events_time (sd))
+    bfin_cosim.next_ticks = sim_events_time (sd) + 1;
