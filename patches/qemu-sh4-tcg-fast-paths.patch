+/*
+ * CDJ_SMC_FASTREJECT (default on; =0 restores QEMU's path): a page keeps
+ * TLB_NOTDIRTY for as long as any TB lives in it, so every guest store to it,
+ * even to data nowhere near the code, comes here. The full path g_malloc()s a
+ * page_collection, builds a QTree, walks the page's TBs and, in the common
+ * case, invalidates nothing. Look at the one page under its own lock first: if
+ * no TB overlaps the written bytes and the page still has TBs, the full path
+ * would neither invalidate nor unprotect, so skip it. Any overlap, or an
+ * empty page, takes the full path. Guest-visible behaviour is unchanged.
+ *
+ * Adapted from cdj-nxs2-qemu by Stijn Jacobs
+ * (https://github.com/Stijn-Jacobs/cdj-nxs2-qemu), used with permission.
+ */
+uint64_t cdj_smc_stores, cdj_smc_overlap, cdj_smc_rejected;
+
+static bool cdj_smc_no_overlap(PageDesc *p, tb_page_addr_t start,
+                               tb_page_addr_t last)
+{
+    TranslationBlock *tb;
+    PageForEachNext n;
+    bool hit = false;
+
+    page_lock(p);
+    /* Same arithmetic as tb_invalidate_phys_page_range__locked(). */
+    PAGE_FOR_EACH_TB(start, last, p, tb, n) {
+        tb_page_addr_t tb_start, tb_last;
+
+        tb_start = tb_page_addr0(tb);
+        tb_last = tb_start + tb->size - 1;
+        if (n == 0) {
+            tb_last = MIN(tb_last, tb_start | ~TARGET_PAGE_MASK);
+        } else {
+            tb_start = tb_page_addr1(tb);
+            tb_last = tb_start + (tb_last & ~TARGET_PAGE_MASK);
+        }
+        if (!(tb_last < start || tb_start > last)) {
+            hit = true;
+            break;
+        }
+    }
+    hit |= !p->first_tb;
+    page_unlock(p);
+    cdj_smc_stores++;
+    cdj_smc_overlap += hit;
+    return !hit;
+}
+
