+/*
+ * May this TB chain directly to dest on another page? Set up in
+ * sh4_tr_init_disas_context(): privileged code with MMUCR.AT clear, where
+ * every address below P4 has a fixed physical mapping and no access check.
+ * Whatever sets MMUCR.AT must flush all TBs (cdj2000_main.c, sh7750.c).
+ */
+static bool cdj_xpage_ok(DisasContext *ctx, vaddr dest)
+{
+    return ctx->cdj_xpage && dest < 0xe0000000;
