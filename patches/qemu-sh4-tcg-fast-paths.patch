+/*
+ * CDJ-2000 emulator: TB-exit fast paths and the jump-cache profiler.
+ *
+ * Adapted from cdj-nxs2-qemu by Stijn Jacobs
+ * (https://github.com/Stijn-Jacobs/cdj-nxs2-qemu), used with permission.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_CDJ_TCG_PROF_H
+#define EXEC_CDJ_TCG_PROF_H
+
+/*
+ * Why the last TB left through a TB lookup, stored by translated code when
+ * CDJ_JCPROF=1 and read by accel/tcg/cpu-exec.c.
+ * ponytail: one global, not per-CPU; every CDJ board has a single vCPU.
+ */
+enum {
+    CDJ_EXIT_UNKNOWN = 0,   /* cpu loop entry: irq, exception, exit request */
+    CDJ_EXIT_RTS,           /* rts: return through PR */
+    CDJ_EXIT_CALL,          /* jsr @Rn, bsrf Rn */
+    CDJ_EXIT_JMP,           /* jmp @Rn, braf Rn */
+    CDJ_EXIT_XPAGE,         /* direct branch or fall-through to another page */
+    CDJ_EXIT_FPSCR,         /* LDS FPSCR changed PR/SZ/FR */
+    CDJ_EXIT_STOP,          /* DISAS_STOP: exit_tb to the cpu loop */
+    CDJ_EXIT_CALLPRED_MISS, /* predicted jsr/jmp target was wrong */
+    CDJ_EXIT_NKINDS
+};
+
+extern uint32_t cdj_exit_kind;
+
+/* Stores into pages holding code (tb-maint.c), for the CDJ_JCPROF report. */
+extern uint64_t cdj_smc_stores, cdj_smc_overlap, cdj_smc_rejected;
+
+/* Read an on-by-default knob once: unset or anything but "0" means on. */
+bool cdj_knob(const char *name, int *cache, bool dflt);
+
+#endif
