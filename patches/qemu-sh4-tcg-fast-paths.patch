+ * flushed), a slot holding another pc (conflict), or the same pc under other
+ * flags. Also prints TLB/TB flush counts and the store-to-code-page counts of
+ * tb-maint.c. Printed every 2^26 lookups and at exit. Read-only: it never
+ * changes what tb_lookup() returns.
+ */
+uint32_t cdj_exit_kind;
+
+bool cdj_knob(const char *name, int *cache, bool dflt)
+{
+    if (unlikely(*cache < 0)) {
+        const char *e = getenv(name);
+
+        *cache = e && *e ? strcmp(e, "0") != 0 : dflt;
+        if (*cache != dflt) {
+            fprintf(stderr, "[CDJ] %s=%d\n", name, *cache);
+        }
+    }
+    return *cache;
+}
+
+enum { CDJ_JC_HIT, CDJ_JC_EMPTY, CDJ_JC_CONFLICT, CDJ_JC_FLAGS, CDJ_JC_NOUT };
+
+static int cdj_jcprof = -1;
+static uint64_t cdj_jc_count[2][CDJ_EXIT_NKINDS][CDJ_JC_NOUT];
+static uint64_t cdj_jc_total;
+static CPUState *cdj_jc_cpu;
+
+static void cdj_jcprof_print(void)
+{
+    static const char *const kname[CDJ_EXIT_NKINDS] = {
+        "unknown", "rts", "call", "jmp", "xpage", "fpscr", "stop", "predmiss",
+    };
+    CPUState *cpu = cdj_jc_cpu;
+    int s, k;
+
+    if (!cpu) {
+        return;
+    }
+    fprintf(stderr, "[CDJ] jcprof lookups=%" PRIu64 " tlbflush full=%zu "
+            "part=%zu tbflush=%u smc stores=%" PRIu64 " overlap=%" PRIu64
+            " fastreject=%" PRIu64 "\n", cdj_jc_total,
+            cpu->neg.tlb.c.full_flush_count, cpu->neg.tlb.c.part_flush_count,
+            qatomic_read(&tb_ctx.tb_flush_count), cdj_smc_stores,
+            cdj_smc_overlap, cdj_smc_rejected);
+    for (s = 0; s < 2; s++) {
+        for (k = 0; k < CDJ_EXIT_NKINDS; k++) {
+            uint64_t *c = cdj_jc_count[s][k];
+
+            if (c[CDJ_JC_HIT] | c[CDJ_JC_EMPTY] | c[CDJ_JC_CONFLICT]
+                | c[CDJ_JC_FLAGS]) {
+                fprintf(stderr, "[CDJ] jcprof %s %-8s hit=%" PRIu64
+                        " empty=%" PRIu64 " conflict=%" PRIu64
+                        " flags=%" PRIu64 "\n", s ? "helper" : "loop  ",
+                        kname[k], c[CDJ_JC_HIT], c[CDJ_JC_EMPTY],
+                        c[CDJ_JC_CONFLICT], c[CDJ_JC_FLAGS]);
+            }
+        }
+    }
+}
+
+static void cdj_jcprof_note(CPUState *cpu, int site, TCGTBCPUState st)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    uint32_t hash = tb_jmp_cache_hash_func(st.pc);
+    TranslationBlock *tb = qatomic_read(&jc->array[hash].tb);
+    unsigned kind = cdj_exit_kind;
+    int out;
+
+    if (!cdj_jc_cpu) {
+        cdj_jc_cpu = cpu;
+        atexit(cdj_jcprof_print);
+    }
+    cdj_exit_kind = CDJ_EXIT_UNKNOWN;
+    if (kind >= CDJ_EXIT_NKINDS) {
+        kind = CDJ_EXIT_UNKNOWN;
+    }
+    if (!tb) {
+        out = CDJ_JC_EMPTY;
+    } else if (jc->array[hash].pc != st.pc) {
+        out = CDJ_JC_CONFLICT;
+    } else if (tb->cs_base != st.cs_base || tb->flags != st.flags
+               || tb_cflags(tb) != st.cflags) {
+        out = CDJ_JC_FLAGS;
+    } else {
+        out = CDJ_JC_HIT;
+    }
+    cdj_jc_count[site][kind][out]++;
+    if ((++cdj_jc_total & ((1u << 26) - 1)) == 0) {
+        cdj_jcprof_print();
+    }
+}
