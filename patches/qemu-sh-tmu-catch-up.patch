+/*
+ * An underflow while UNF is still set, with its interrupt enabled, is one the
+ * guest has not been told about yet.  On the chip that happens only to a
+ * handler more than a period late, which an RTOS's tick handler never is.
+ * Here the host decides when the timer's callback and the guest's handler
+ * run: a busy host runs two expiries in one pass of the main loop, or keeps
+ * the vCPU from the handler for longer than a period, and an RTOS that counts
+ * one tick per interrupt falls behind QEMU_CLOCK_VIRTUAL for good.  Count
+ * them, and raise UNF again each time the guest clears it until it has seen
+ * every one: late, but none lost, so the guest's time keeps up with the
+ * clock.  At most TIMER_MISSED_MAX are kept.  Stopping the channel, clearing
+ * UNIE or a reset drops them, and UNF with them unless the chip would show it
+ * (sh_timer_drop_missed), so a handler that clears UNF and then stops its
+ * channel takes no interrupt after the stop.
+ */
+#define TIMER_MISSED_MAX 1000
+
 static void sh_timer_tick(void *opaque)
 {
     SHTimerState *s = opaque;
+    if (s->enabled && s->int_level && (s->tcr & TIMER_TCR_UNIE) &&
+        s->missed < TIMER_MISSED_MAX) {
+        s->missed++;
+    }
     s->int_level = s->enabled;
+    s->unf_kept = false;
     sh_timer_update(s);
 }
 
