+/*
+ * Forget the underflows kept for the guest (see sh_timer_tick).  UNF is left
+ * as the chip has it: set only if an underflow came after the guest last
+ * cleared it, so a UNF that was set again for a kept underflow goes too.
+ */
+static void sh_timer_drop_missed(SHTimerState *s)
+{
+    s->missed = 0;
+    if (s->unf_kept) {
+        s->unf_kept = false;
+        s->int_level = 0;
+    }
+}
