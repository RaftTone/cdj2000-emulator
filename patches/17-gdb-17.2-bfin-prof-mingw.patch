-  bfin_prof.frames = open_memstream (&bfin_prof.frames_buf,
-				     &bfin_prof.frames_len);
+  bfin_prof.frames = bfin_prof_frames_open ();
   if (!bfin_prof.slot || !bfin_prof.stk || !bfin_prof.frames)
     {
       fprintf (stderr, "bfin: BFIN_PROF cannot allocate or open %s\n",
@@ -1167,7 +1210,7 @@
