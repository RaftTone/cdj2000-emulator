+/* Native packets are byte bursts, not descriptors with an exact size.
+   Opt-in: preserve legacy cache/probe behavior and deliver a fresh DLNK burst
+   into an oversized RX descriptor once, returning only actual received bytes. */
+static unsigned
+bfin_sport_link_take_native (struct bfin_sport *sport, void *dest, unsigned capacity)
+{
+  const char *env = getenv ("BFIN_LINK_NATIVE_PARTIAL_DMA");
+  unsigned slot, step, depth = bfin_sport_link_depth ();
+  if (!env || strcmp (env, "1")) return 0;
+  for (slot = 0; slot < BFIN_LINK_SIZES; slot++)
+    {
+      unsigned n = sport->link_frame_len[slot];
+      unsigned get = sport->link_frame_get[slot] % depth;
+      if (n < 4 || n > capacity || n % 2) continue;
+      for (step = 0; step < depth; step++)
+        {
+          unsigned entry = (get + step) % depth;
+          if (!sport->link_frame_fresh[slot][entry]
+              || memcmp (sport->link_frame[slot][entry], "DLNK", 4)) continue;
+          memcpy (dest, sport->link_frame[slot][entry], n);
+          sport->link_frame_fresh[slot][entry] = 0;
+          sport->link_frame_get[slot] = (entry + 1) % depth;
+          sport->link_take_fresh = 1;
+          return n;
+        }
+    }
+  return 0;
+}
