+static void sh_timer_channel_reset(SHTimerState *s)
+{
+    ptimer_transaction_begin(s->timer);
+    ptimer_stop(s->timer);
+    ptimer_set_limit(s->timer, UINT32_MAX, 0);
+    ptimer_set_count(s->timer, UINT32_MAX);
+    ptimer_transaction_commit(s->timer);
+    s->enabled = 0;
+    s->int_level = 0;
+    s->old_level = 0;
+    s->tcor = UINT32_MAX;
+    s->tcnt = UINT32_MAX;
+    s->tcr = 0;
+    s->tcpr = 0xdeadbeef;
+    qemu_set_irq(s->irq, 0);
+}
+
+static void tmu012_reset(void *opaque)
+{
+    tmu012_state *s = opaque;
+
+    for (unsigned int i = 0; i < 3; ++i) {
+        if (s->timer[i]) {
+            sh_timer_channel_reset(s->timer[i]);
+        }
+    }
+    s->tstr = 0;
+    s->tocr = 0;
+}
+
 void tmu012_init(MemoryRegion *sysmem, hwaddr base, int feat, uint32_t freq,
