+
+#ifdef CONFIG_DARWIN
+    short_wait = arm_short_wait(timeout);
+    if (short_wait) {
+        /* The kqueue timer ends the wait; this is only a backstop. */
+        timeout = 20 * SCALE_MS;
+    }
+#endif
 
     bql_unlock();
     replay_mutex_unlock();
@@ -311,6 +382,12 @@
 
     replay_mutex_lock();
     bql_lock();
+
+#ifdef CONFIG_DARWIN
+    if (short_wait) {
